{
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx"
  },
  "include": ["e2e/**/*"],
  "exclude": ["packages/web"] // web 有独立 tsconfig（含 DOM lib），走 pnpm --filter @beaver/web typecheck
}
