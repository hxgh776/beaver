{
  "name": "beaver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @beaver/web build && node scripts/sync-web-dist.mjs",
    "build:go-web": "pnpm --filter @beaver/web build && node scripts/sync-web-dist.mjs",
    "test": "go test ./...",
    "test:e2e": "pnpm --filter @beaver/e2e test",
    "lint": "eslint e2e",
    "typecheck": "pnpm --filter @beaver/web typecheck && tsc -p tsconfig.check.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  }
}
